{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@compat/playwright": ["./node_modules/@playwright/test/index.d.ts"]
    }
  },
  "include": ["src", "tests", "*.ts", "../shared/*.ts"]
}
