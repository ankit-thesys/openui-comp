{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@compat/playwright": ["./node_modules/@playwright/test/index.d.ts"]
    },
    "rootDirs": [".", "./.react-router/types"],
    "allowJs": true
  },
  "include": [
    "app",
    "tests",
    "*.ts",
    "../shared/*.ts",
    ".react-router/types/**/*",
    "scripts/check-stream.mjs"
  ]
}
