{
  "name": "@openuidev/chat-kit",
  "version": "0.0.0-beta.0",
  "description": "OpenUI React chat components and AI component library",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lib": {
      "import": {
        "types": "./dist/lib/index.d.mts",
        "default": "./dist/lib/index.mjs"
      },
      "require": {
        "types": "./dist/lib/index.d.cts",
        "default": "./dist/lib/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format:check": "prettier --check ./src",
    "format:fix": "prettier --write ./src",
    "check:publint": "publint",
    "check:attw": "attw --pack . --ignore-rules no-resolution",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run check:publint && pnpm run check:attw",
    "ci": "pnpm run lint:check && pnpm run format:check && pnpm run typecheck"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "goober": "2.1.19",
    "lucide-react": "^0.562.0"
  },
  "peerDependencies": {
    "@openuidev/react-lang": ">=1.0.1 <2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76 || ^4.0.0",
    "@openuidev/react-components": "0.0.0-beta.0"
  },
  "devDependencies": {
    "@openuidev/react-lang": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "catalog:",
    "@openuidev/react-components": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesysdev/openui.git",
    "directory": "packages/kits/chat"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "typesVersions": {
    "*": {
      "lib": [
        "dist/lib/index.d.cts"
      ]
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "keywords": [
    "openui",
    "chat",
    "generative-ui",
    "ai",
    "component-library",
    "openui-lang",
    "chatbot",
    "llm"
  ],
  "homepage": "https://openui.com",
  "author": "engineering@thesys.dev",
  "bugs": {
    "url": "https://github.com/thesysdev/openui/issues"
  }
}
