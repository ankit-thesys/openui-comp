{
  "name": "@openuidev/dashboard-kit",
  "version": "0.0.0-beta.0",
  "description": "OpenUI dashboard AI component library",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lib": {
      "import": {
        "types": "./dist/lib/index.d.mts",
        "default": "./dist/lib/index.mjs"
      },
      "require": {
        "types": "./dist/lib/index.d.cts",
        "default": "./dist/lib/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "goober": "2.1.19",
    "lucide-react": "^0.562.0"
  },
  "peerDependencies": {
    "@openuidev/react-components": "0.0.0-beta.0",
    "@openuidev/react-lang": ">=1.0.1 <2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "@openuidev/react-components": "workspace:^",
    "@openuidev/react-lang": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "catalog:"
  }
}
