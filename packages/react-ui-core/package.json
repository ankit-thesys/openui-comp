{
  "name": "@openuidev/react-ui-core",
  "version": "0.0.0-beta.0",
  "description": "Reusable OpenUI React components and themes",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && cd ../.. && node --test packages/react-ui-core/tests/*.test.mjs packages/react-ui-core/src/components/*/__tests__/*.test.mjs",
    "format:check": "prettier --check src tests *.json *.ts",
    "check:publint": "publint",
    "check:attw": "attw --pack .",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run check:publint && pnpm run check:attw",
    "lint:check": "eslint src --ignore-pattern \"**/__tests__/**\"",
    "ci": "pnpm run format:check && pnpm run lint:check && pnpm run typecheck && pnpm run test && pnpm run check:publint && pnpm run check:attw"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "goober": "2.1.19",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-slider": "^1.2.2",
    "@floating-ui/react-dom": "^2.1.2",
    "react-day-picker": "^9.5.1",
    "date-fns": "^4.1.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.562.0",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "react-syntax-highlighter": "^16.1.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "katex": "^0.16.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "esbuild": "^0.25.12",
    "@types/lodash-es": "^4.17.12",
    "zod": "catalog:",
    "@types/react-syntax-highlighter": "^15.5.13",
    "vite": "6.4.2",
    "playwright": "1.59.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesysdev/openui.git",
    "directory": "packages/react-ui-core"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
