{
  "name": "openui-styling-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run demo",
    "build": "node scripts/build-frameworks.mjs && node scripts/build-library.mjs && vite build",
    "start": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "demo": "npm run build && npm start",
    "report": "node scripts/report.mjs",
    "check:next": "node scripts/check-next.mjs",
    "check:all": "node scripts/run-checks.mjs",
    "compat:prepare": "node scripts/pack-prototype.mjs && node scripts/prepare-compat.mjs",
    "check:compat": "node scripts/check-compat.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "demo:compat": "node scripts/demo-compat.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "build:real": "node scripts/build-real.mjs",
    "demo:real": "npm run build:real && node .real-dist/server.cjs",
    "check:real:browser": "node scripts/check-real-browser.mjs",
    "check:real:ssr": "REAL_SSR_INCLUDE_50=1 node scripts/check-real-ssr.mjs",
    "report:real": "node scripts/report-real.mjs"
  },
  "dependencies": {
    "goober": "^2.1.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "bootstrap": "^5.3.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "tailwindcss-v3": "npm:tailwindcss@^3.4.0",
    "vite": "^7.0.0"
  }
}
