    "autoprefixer": "^10.4.0",
    "bootstrap": "^5.3.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "tailwindcss-v3": "npm:tailwindcss@^3.4.0",
    "vite": "^7.0.0"
