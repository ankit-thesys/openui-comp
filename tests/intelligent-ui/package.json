{
  "name": "@openuidev/intelligent-ui-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Fork-only tests for @openuidev/intelligent-ui-library. Never merged upstream.",
  "type": "module",
  "scripts": {
    "build:library": "pnpm --filter \"@openuidev/intelligent-ui-library...\" --workspace-concurrency=1 run build",
    "build:host": "vite build --config host/vite.config.ts",
    "host": "vite --config host/vite.config.ts",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "generate:models": "node models/generate.ts"
  },
  "dependencies": {
    "@openuidev/intelligent-ui-library": "workspace:*",
    "@openuidev/lang-core": "workspace:*",
    "@openuidev/react-components": "workspace:*",
    "@openuidev/react-lang": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@playwright/test": "1.56.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "4.1.2",
    "react-18": "npm:react@18.3.1",
    "react-dom-18": "npm:react-dom@18.3.1",
    "typescript": "catalog:",
    "vite": "^7.0.0"
  }
}
