# Vite build output for the browser fixture. Regenerated by browser/run.mjs on
# every run (or `--no-build` to reuse), so committing it would add ~1.4MB of
# derived bundle for no reproducibility benefit.
dist/
browser/dist/

# Vite's dep-optimizer cache, if one is ever created here.
.vite-cache/

# Belt and braces: the repository root already ignores node_modules, and this
# directory is deliberately NOT a pnpm workspace member, so nothing should
# install here.
node_modules/
